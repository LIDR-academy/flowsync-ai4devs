{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/format-frontend.cjs",
            "shell": "bash",
            "timeout": 30,
            "statusMessage": "Formatting frontend file with Prettier..."
          }
        ]
      }
    ]
  }
}
