# Lo mínimo para que dos editores no discutan. El formato lo decide Prettier;
# esto solo evita que un fichero nazca con tabuladores o sin salto final.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab

[*.md]
trim_trailing_whitespace = false
