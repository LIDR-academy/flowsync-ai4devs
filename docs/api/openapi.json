{
  "info": {
    "title": "FlowSync API",
    "version": "1.0.0"
  },
  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Access token opaco emitido por `POST /api/v1/auth/login`, en la cabecera `Authorization: Bearer <token>`."
      }
    },
    "schemas": {
      "SignupBody": {
        "type": "object",
        "properties": {
          "fullName": {
            "type": "string",
            "nullable": true,
            "example": "Ada Lovelace",
            "description": "Obligatorio en el payload, aceptando `null`. Omitirlo devuelve 422 (H-04)."
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          },
          "password": {
            "type": "string",
            "format": "password",
            "minLength": 8
          },
          "passwordConfirmation": {
            "type": "string",
            "format": "password",
            "description": "Debe coincidir con `password`."
          }
        },
        "required": [
          "fullName",
          "email",
          "password",
          "passwordConfirmation"
        ]
      },
      "AccessTokenResponse": {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/AccessTokenGrant"
          }
        },
        "required": [
          "data"
        ]
      },
      "AccessTokenGrant": {
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/Account"
          },
          "token": {
            "type": "string",
            "example": "oat_MTA.abc123",
            "description": "Access token opaco. Va en `Authorization: Bearer <token>`."
          }
        },
        "required": [
          "user",
          "token"
        ]
      },
      "Account": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number",
            "example": 1
          },
          "fullName": {
            "type": "string",
            "nullable": true,
            "example": "Ada Lovelace",
            "description": "Nulo cuando la cuenta se registró sin nombre."
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "ada@flowsync.test"
          },
          "initials": {
            "type": "string",
            "example": "AL"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "fullName",
          "email",
          "initials",
          "createdAt",
          "updatedAt"
        ]
      },
      "ValidationErrorResponse": {
        "type": "object",
        "properties": {
          "errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ValidationErrorItem"
            }
          }
        },
        "required": [
          "errors"
        ]
      },
      "ValidationErrorItem": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "example": "The title field must be defined"
          },
          "rule": {
            "type": "string",
            "example": "required"
          },
          "field": {
            "type": "string",
            "example": "title"
          }
        },
        "required": [
          "message",
          "rule",
          "field"
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ErrorItem"
            }
          }
        },
        "required": [
          "errors"
        ]
      },
      "ErrorItem": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "example": "Unauthorized access"
          }
        },
        "required": [
          "message"
        ]
      },
      "LoginBody": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "format": "password"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "LogoutResponse": {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/LogoutMessage"
          }
        },
        "required": [
          "data"
        ]
      },
      "LogoutMessage": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "example": "Logged out successfully"
          }
        },
        "required": [
          "message"
        ]
      },
      "AccountResponse": {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/Account"
          }
        },
        "required": [
          "data"
        ]
      },
      "TaskListResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Task"
            }
          }
        },
        "required": [
          "data"
        ]
      },
      "Task": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number",
            "example": 1
          },
          "title": {
            "type": "string",
            "maxLength": 200,
            "example": "Revisar el informe"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "in_progress",
              "done"
            ],
            "example": "pending"
          },
          "assignee": {
            "$ref": "#/components/schemas/TaskAssignee"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "title",
          "status",
          "assignee",
          "createdAt",
          "updatedAt"
        ]
      },
      "TaskAssignee": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number",
            "example": 1
          },
          "fullName": {
            "type": "string",
            "nullable": true,
            "example": "Ada Lovelace",
            "description": "Nulo cuando la cuenta se registró sin nombre. Las iniciales siguen llegando."
          },
          "initials": {
            "type": "string",
            "example": "AL"
          }
        },
        "required": [
          "id",
          "fullName",
          "initials"
        ]
      },
      "TaskDetailResponse": {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/TaskDetail"
          }
        },
        "required": [
          "data"
        ]
      },
      "TaskDetail": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number",
            "example": 1
          },
          "title": {
            "type": "string",
            "maxLength": 200,
            "example": "Revisar el informe"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "in_progress",
              "done"
            ],
            "example": "pending"
          },
          "dueDate": {
            "type": "string",
            "format": "date",
            "nullable": true,
            "example": "2026-09-30",
            "description": "Día del calendario `AAAA-MM-DD`, sin hora ni huso. Nulo si la tarea no tiene."
          },
          "isOverdue": {
            "type": "boolean",
            "description": "Resuelto contra el `today` de la petición: hay fecha, es anterior a ese día y el estado no es `done`."
          },
          "assignee": {
            "$ref": "#/components/schemas/TaskAssignee"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "title",
          "status",
          "dueDate",
          "isOverdue",
          "assignee",
          "createdAt",
          "updatedAt"
        ]
      },
      "CreateTaskBody": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "example": "Revisar el informe",
            "description": "Se recortan los espacios de los extremos antes de comprobar la longitud: un título de solo espacios se rechaza igual que uno vacío, y pasarse de 200 es un error, nunca un recorte."
          }
        },
        "required": [
          "title"
        ]
      },
      "TaskResponse": {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/Task"
          }
        },
        "required": [
          "data"
        ]
      },
      "UpdateTaskStatusBody": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "in_progress",
              "done"
            ],
            "example": "in_progress",
            "description": "Cualquiera de los tres estados. Todas las transiciones valen, incluida la vuelta desde `done`."
          }
        },
        "required": [
          "status"
        ]
      },
      "SetTaskDueDateBody": {
        "type": "object",
        "properties": {
          "dueDate": {
            "type": "string",
            "format": "date",
            "nullable": true,
            "example": "2026-09-30",
            "description": "`null` retira la fecha, y es un valor legítimo del campo, no un error."
          },
          "today": {
            "type": "string",
            "format": "date",
            "example": "2026-08-27",
            "description": "Día de referencia con el que se resuelve `isOverdue` en la respuesta. Obligatorio y sin valor por defecto."
          }
        },
        "required": [
          "dueDate",
          "today"
        ]
      }
    }
  },
  "openapi": "3.0.0",
  "paths": {
    "/api/v1/auth/signup": {
      "post": {
        "summary": "Dar de alta una cuenta y abrir sesión",
        "tags": [
          "NewAccount"
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccessTokenResponse"
                }
              }
            }
          },
          "422": {
            "description": "Falta un campo, el email ya existe, o las contraseñas no coinciden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Algo falló y no estaba previsto. El cuerpo es siempre el mismo y no lleva traza, ni rutas del disco, ni la sentencia SQL (ADR-0005).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignupBody"
              }
            }
          }
        },
        "parameters": [],
        "security": []
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "summary": "Abrir sesión y obtener un access token",
        "tags": [
          "AccessTokens"
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccessTokenResponse"
                }
              }
            }
          },
          "400": {
            "description": "Credenciales inválidas",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Algo falló y no estaba previsto. El cuerpo es siempre el mismo y no lleva traza, ni rutas del disco, ni la sentencia SQL (ADR-0005).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginBody"
              }
            }
          }
        },
        "parameters": [],
        "security": []
      }
    },
    "/api/v1/account/logout": {
      "post": {
        "summary": "Cerrar la sesión actual",
        "tags": [
          "AccessTokens"
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LogoutResponse"
                }
              }
            }
          },
          "401": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Algo falló y no estaba previsto. El cuerpo es siempre el mismo y no lleva traza, ni rutas del disco, ni la sentencia SQL (ADR-0005).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "parameters": [],
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/api/v1/account/profile": {
      "get": {
        "summary": "La cuenta de quien pregunta",
        "tags": [
          "Profile"
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountResponse"
                }
              }
            }
          },
          "401": {
            "description": "Sin sesión o con un token inválido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Algo falló y no estaba previsto. El cuerpo es siempre el mismo y no lleva traza, ni rutas del disco, ni la sentencia SQL (ADR-0005).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "parameters": [],
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/api/v1/tasks": {
      "get": {
        "summary": "La lista compartida del espacio",
        "description": "Devuelve el mismo conjunto para cualquier cuenta que pida el mismo alcance, sin paginar. Sin acotar, primero las que están en curso y después las pendientes, cada grupo de la más reciente a la más antigua; acotada por un estado, de la más reciente a la más antigua. Sin acotar, el alcance son las pendientes y las que están en curso; las hechas se quedan fuera y solo se alcanzan pidiéndolas por su estado. No informa del vencimiento, y por eso no pide día de referencia.",
        "tags": [
          "Tasks"
        ],
        "responses": {
          "200": {
            "description": "La lista del alcance pedido, entera. Ninguna tarea trae fecha ni condición de vencida.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskListResponse"
                }
              }
            }
          },
          "401": {
            "description": "Falta el token o no es válido. No se devuelve ninguna tarea.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "El estado por el que se pide acotar no es ninguno de los tres del dominio. Se rechaza señalando el campo, y **no** se devuelve una lista vacía: confundir «no existe ese estado» con «no hay nada en ese estado» es el fallo silencioso que este filtro existe para evitar.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Algo falló y no estaba previsto. El cuerpo es siempre el mismo y no depende de qué excepción se lanzara: el mensaje de un error inesperado lo escribe la librería que falló y describe el fallo, no el producto (ADR-0005). No lleva traza, ni rutas del disco, ni la sentencia SQL.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "in": "query",
            "name": "status",
            "required": false,
            "description": "Acota la lista a un estado. El estado es la única dimensión por la que se puede acotar. Sin él llegan `pending` e `in_progress`. Un valor que no sea uno de los tres se rechaza con `422` señalando el campo, y **nunca** devuelve una lista vacía: confundir «no existe ese estado» con «no hay nada en ese estado» es el fallo silencioso que este filtro existe para evitar.",
            "schema": {
              "type": "string",
              "enum": [
                "pending",
                "in_progress",
                "done"
              ]
            }
          }
        ],
        "security": [
          {
            "bearer": []
          }
        ]
      },
      "post": {
        "summary": "Crear una tarea con solo el título",
        "description": "El título es el único dato que se lee. La tarea nace en `pending` y a nombre de la cuenta dueña del token: un `status` o un responsable enviados en el cuerpo se ignoran, no se rechazan. Tampoco admite fecha de vencimiento, que se pone después con `PUT /tasks/{id}/due-date`.",
        "tags": [
          "Tasks"
        ],
        "responses": {
          "201": {
            "description": "La tarea ya creada, en `pending` y a nombre de quien la envió.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskResponse"
                }
              }
            }
          },
          "401": {
            "description": "Falta el token o no es válido. No se crea ninguna tarea.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "El título falta, está vacío, es solo espacios o pasa de 200 caracteres. No se crea ninguna tarea ni se guarda una versión recortada.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Algo falló y no estaba previsto. El cuerpo es siempre el mismo y no depende de qué excepción se lanzara: el mensaje de un error inesperado lo escribe la librería que falló y describe el fallo, no el producto (ADR-0005). No lleva traza, ni rutas del disco, ni la sentencia SQL.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateTaskBody"
              }
            }
          }
        },
        "parameters": [],
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/api/v1/tasks/{id}": {
      "get": {
        "summary": "Una tarea suelta, con su vencimiento resuelto",
        "description": "Devuelve la tarea entera —fecha de vencimiento incluida, o su ausencia— con `isOverdue` ya resuelto contra el día que indique quien pregunta. No comprueba quién es el responsable: una tarea ajena llega igual que una propia, y mirarla no la cambia.",
        "tags": [
          "Tasks"
        ],
        "responses": {
          "200": {
            "description": "La tarea, con su fecha de vencimiento y su condición de vencida.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskDetailResponse"
                }
              }
            }
          },
          "401": {
            "description": "Falta el token o no es válido. No se devuelve ninguna tarea.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "No existe ninguna tarea con ese identificador.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Falta `today` o no es una fecha válida. No se devuelve ninguna tarea.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Algo falló y no estaba previsto. El cuerpo es siempre el mismo y no depende de qué excepción se lanzara: el mensaje de un error inesperado lo escribe la librería que falló y describe el fallo, no el producto (ADR-0005). No lleva traza, ni rutas del disco, ni la sentencia SQL.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "in": "query",
            "name": "today",
            "required": true,
            "example": "2026-08-27",
            "description": "Día de referencia `AAAA-MM-DD` contra el que se decide el vencimiento. Obligatorio y sin valor por defecto: el sistema no sustituye el día que falte por el de su propio reloj.",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/api/v1/tasks/{id}/status": {
      "patch": {
        "summary": "Cambiar el estado de una tarea",
        "description": "Cualquier cuenta con sesión cambia el estado de cualquier tarea, sea o no la responsable, y en cualquier dirección: volver de `done` a `pending` está permitido. El título y el responsable no se tocan. Responde con la forma de lista, sin fecha ni condición de vencida, así que no pide día de referencia.",
        "tags": [
          "TaskStatuses"
        ],
        "responses": {
          "200": {
            "description": "La tarea ya en el estado de destino.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskResponse"
                }
              }
            }
          },
          "401": {
            "description": "Falta el token o no es válido. Nada cambia.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "No existe ninguna tarea con ese identificador. Se comprueba **después** del cuerpo: una petición mal formada sobre un identificador inexistente responde `422` (ADR-0006).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
