{
  "description": "Format project files after Codex edits.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/post_tool_use_format.py\"",
            "timeout": 120,
            "statusMessage": "Formatting edited files"
          }
        ]
      }
    ]
  }
}
