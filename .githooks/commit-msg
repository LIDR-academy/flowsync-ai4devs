#!/bin/sh
#
# El asunto del commit sigue Conventional Commits: `tipo(ámbito)!: qué`.
#
# No es estética. R-08 decide si un commit es un arreglo leyendo si empieza
# por `fix:`, y el CHANGELOG, si algún día se genera, sale de aquí. Un asunto
# libre no rompe nada hoy y deja de contar mañana, que es el fallo silencioso.
#
# Lo prueba scripts/probar-hook-mensaje.mjs, que corre en CI.

asunto=$(grep -v '^#' "$1" | sed -n '1p')

case "$asunto" in
  "Merge "* | "Revert "* | "fixup! "* | "squash! "*)
    exit 0
    ;;
esac

if ! printf '%s\n' "$asunto" | grep -Eq '^(feat|fix|docs|chore|refactor|test|ci|build|perf|style|revert)(\([^)]+\))?!?: [^ ]'; then
  echo "commit-msg: el asunto no sigue 'tipo(ámbito): qué' (AGENTS.md)." >&2
  echo "  tipos: feat fix docs chore refactor test ci build perf style revert" >&2
  echo "  recibido: $asunto" >&2
  exit 1
fi
