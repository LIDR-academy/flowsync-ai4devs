# Entorno de las suites de prueba.
#
# El fichero de base de datos NO se declara aqui a proposito: lo decide
# `config/database.ts` a partir del entorno (ADR-0001), de modo que apuntar la
# suite a la base de desarrollo no sea una variable mal puesta sino algo
# imposible.
SESSION_DRIVER=memory

# Solo lo que rompa una prueba merece salir por consola.
LOG_LEVEL=warn

# La suite no puede depender del `.env` local de quien la ejecuta. ADR-0003
# invita a encender el volcado de depuracion a proposito, y quien lo haga se
# encontraria en rojo las pruebas de H-19 por su configuracion, no por el
# codigo. El valor por defecto del handler lo sigue vigilando el verificador.
DEBUG_HTTP_ERRORS=false
