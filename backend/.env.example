# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie

#--------------------------------------------------------------------
# CORS (configure allowed origins for API access)
#--------------------------------------------------------------------
# CORS_ORIGIN=http://localhost:5173,http://localhost:3000

#--------------------------------------------------------------------
# Frontend (URL a la que se redirige tras completar el login social)
#--------------------------------------------------------------------
FRONTEND_URL=http://localhost:5173

#--------------------------------------------------------------------
# Login social con Google (@adonisjs/ally)
# Crea las credenciales OAuth en https://console.cloud.google.com/apis/credentials
# Callback URL a registrar en Google: ${APP_URL}/api/v1/auth/google/callback
#--------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=