# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie

#--------------------------------------------------------------------
# CORS (configure allowed origins for API access)
#--------------------------------------------------------------------
# CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Devuelve el volcado de depuracion en el cuerpo de los errores HTTP.
# Apagado por defecto (ADR-0003): el diagnostico sale por el log del servidor.
DEBUG_HTTP_ERRORS=false
