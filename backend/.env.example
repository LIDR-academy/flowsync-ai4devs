# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie

#--------------------------------------------------------------------
# CORS (configure allowed origins for API access)
#--------------------------------------------------------------------
# CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# El volcado de depuracion de errores HTTP va apagado en todos los entornos
# (ADR-0003). Encendido devuelve traza, rutas del disco y el SQL ejecutado en el
# cuerpo de la respuesta, y basta alcanzar el puerto para leerlo.
DEBUG_HTTP_ERRORS=false
